# 応答ヘッダー (docs/design/07-security.md)。Cloudflare がこのファイルを読み、E2E のサーバー (e2e/serve.ts) も同じものを付ける。
# 中身は tooling/headers.test.ts が確かめる
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), screen-wake-lock=(self)
  Cross-Origin-Opener-Policy: same-origin

# ファイル名にハッシュが入るので、長く持たせてよい
/assets/*
  Cache-Control: public, max-age=31536000, immutable
